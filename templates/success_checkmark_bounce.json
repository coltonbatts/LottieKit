{
  "id": "success_checkmark_bounce",
  "name": "Success Checkmark Bounce",
  "version": "0.1.0",
  "description": "A checkmark draws in and the group scales with a subtle bounce.",
  "category": "status",
  "compatibility": {"renderers": ["web"], "notes": "Trim paths + transform scale only."},
  "params": {
    "fps": {"type": "number", "default": 60},
    "durationFrames": {"type": "number", "default": 90},
    "size": {"type": "number", "default": 100},
    "colorPrimary": {"type": "color", "default": "#16A34A"},
    "stroke": {"type": "number", "default": 6, "min": 1, "max": 16},
    "bounceOvershoot": {"type": "number", "default": 110, "min": 100, "max": 130}
  },
  "constraints": {"maxLayers": 3, "allowExpressions": false},
  "template": {
    "v": "5.9.0",
    "fr": ${params.fps},
    "ip": 0,
    "op": ${params.durationFrames},
    "w": ${params.size},
    "h": ${params.size},
    "layers": [
      {
        "ddd": 0,
        "ind": 1,
        "ty": 4,
        "nm": "Check Group",
        "sr": 1,
        "ks": {
          "o": {"a": 0, "k": 100},
          "r": {"a": 0, "k": 0},
          "p": {"a": 0, "k": [${calc(params.size/2)}, ${calc(params.size/2)}, 0]},
          "a": {"a": 0, "k": [0, 0, 0]},
          "s": {
            "a": 1,
            "k": [
              {"t": 0, "s": [0, 0, 100], "e": [${params.bounceOvershoot}, ${params.bounceOvershoot}, 100], "i": {"x": [0.2,0.2,0.2], "y": [0,0,0]}, "o": {"x": [0.3,0.3,0.3], "y": [1,1,1]}},
              {"t": ${calc(params.durationFrames*0.35)}, "s": [${params.bounceOvershoot}, ${params.bounceOvershoot}, 100], "e": [100, 100, 100], "i": {"x": [0.5,0.5,0.5], "y": [0,0,0]}, "o": {"x": [0.2,0.2,0.2], "y": [1,1,1]}},
              {"t": ${params.durationFrames}}
            ]
          }
        },
        "ao": 0,
        "shapes": [
          {"ty": "gr", "nm": "Check Shape Group", "it": [
            {
              "ty": "sh",
              "ks": {
                "a": 0,
                "k": {
                  "i": [[0,0],[0,0],[0,0]],
                  "o": [[0,0],[0,0],[0,0]],
                  "v": [[${calc(-params.size*0.18)}, 0], [ ${calc(-params.size*0.02)}, ${calc(params.size*0.18)}], [ ${calc(params.size*0.28)}, ${calc(-params.size*0.16)} ]],
                  "c": false
                }
              },
              "nm": "Check Path"
            },
            {
              "ty": "st",
              "c": {"a": 0, "k": ${color(${params.colorPrimary})}},
              "o": {"a": 0, "k": 100},
              "w": {"a": 0, "k": ${params.stroke}},
              "lc": 2,
              "lj": 2,
              "nm": "Stroke"
            },
            {
              "ty": "tm",
              "s": {"a": 0, "k": 0},
              "e": {"a": 1, "k": [
                {"t": 0, "s": [0], "e": [100], "i": {"x": [0.4], "y": [0]}, "o": {"x": [0.2], "y": [1]}},
                {"t": ${calc(params.durationFrames*0.3)}}
              ]},
              "o": {"a": 0, "k": 0},
              "m": 1,
              "nm": "Trim Paths"
            }
          ]}
        ],
        "ip": 0,
        "op": ${params.durationFrames},
        "st": 0,
        "bm": 0
      }
    ]
  }
}
