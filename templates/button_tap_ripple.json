{
  "id": "button_tap_ripple",
  "name": "Button Tap Ripple",
  "version": "0.1.0",
  "description": "A ripple circle expands and fades, centered in frame.",
  "category": "interaction",
  "compatibility": {"renderers": ["web"], "notes": "Stroke ellipse with animating scale and opacity."},
  "params": {
    "fps": {"type": "number", "default": 60},
    "durationFrames": {"type": "number", "default": 45},
    "size": {"type": "number", "default": 120},
    "colorPrimary": {"type": "color", "default": "#0EA5E9"},
    "stroke": {"type": "number", "default": 4, "min": 1, "max": 12},
    "startScale": {"type": "number", "default": 20, "min": 1, "max": 100},
    "endScale": {"type": "number", "default": 150, "min": 100, "max": 300}
  },
  "constraints": {"maxLayers": 2, "allowExpressions": false},
  "template": {
    "v": "5.9.0",
    "fr": ${params.fps},
    "ip": 0,
    "op": ${params.durationFrames},
    "w": ${params.size},
    "h": ${params.size},
    "layers": [
      {
        "ddd": 0,
        "ind": 1,
        "ty": 4,
        "nm": "Ripple",
        "sr": 1,
        "ks": {
          "o": {
            "a": 1,
            "k": [
              {"t": 0, "s": [100], "e": [0], "i": {"x": [0.4], "y": [0]}, "o": {"x": [0.2], "y": [1]}},
              {"t": ${params.durationFrames}}
            ]
          },
          "r": {"a": 0, "k": 0},
          "p": {"a": 0, "k": [${params.size}/2, ${params.size}/2, 0]},
          "a": {"a": 0, "k": [0, 0, 0]},
          "s": {
            "a": 1,
            "k": [
              {"t": 0, "s": [${params.startScale}, ${params.startScale}, 100], "e": [${params.endScale}, ${params.endScale}, 100], "i": {"x": [0.4,0.4,0.4], "y": [0,0,0]}, "o": {"x": [0.2,0.2,0.2], "y": [1,1,1]}},
              {"t": ${params.durationFrames}}
            ]
          }
        },
        "ao": 0,
        "shapes": [
          {"ty": "el", "p": {"a": 0, "k": [0, 0]}, "s": {"a": 0, "k": [${params.size}*0.2, ${params.size}*0.2]}, "nm": "Ellipse Path"},
          {"ty": "st", "c": {"a": 0, "k": [
            (parseInt(${params.colorPrimary}.slice(1,3),16))/255,
            (parseInt(${params.colorPrimary}.slice(3,5),16))/255,
            (parseInt(${params.colorPrimary}.slice(5,7),16))/255,
            1
          ]}, "o": {"a": 0, "k": 100}, "w": {"a": 0, "k": ${params.stroke}}, "lc": 2, "lj": 2, "nm": "Stroke"}
        ],
        "ip": 0,
        "op": ${params.durationFrames},
        "st": 0,
        "bm": 0
      }
    ]
  }
}
