{
  "id": "gentle_pulse_loader",
  "name": "Gentle Pulse Loader",
  "version": "0.1.0",
  "description": "A simple circular pulse loader with smooth in-out scaling.",
  "category": "loader",
  "compatibility": {"renderers": ["web"], "notes": "Avoid expressions; shape + transform only."},
  "params": {
    "fps": {"type": "number", "default": 60, "min": 30, "max": 60, "unit": "fps"},
    "durationFrames": {"type": "number", "default": 60, "min": 30, "max": 240},
    "size": {"type": "number", "default": 100, "min": 24, "max": 512, "unit": "px"},
    "colorPrimary": {"type": "color", "default": "#4F46E5"},
    "stroke": {"type": "number", "default": 0, "min": 0, "max": 16},
    "scaleMin": {"type": "number", "default": 90, "min": 50, "max": 100},
    "scaleMax": {"type": "number", "default": 110, "min": 100, "max": 150}
  },
  "constraints": {"maxLayers": 2, "allowExpressions": false},
  "template": {
    "v": "5.9.0",
    "fr": ${params.fps},
    "ip": 0,
    "op": ${params.durationFrames},
    "w": ${params.size},
    "h": ${params.size},
    "layers": [
      {
        "ddd": 0,
        "ind": 1,
        "ty": 4,
        "nm": "Pulse",
        "sr": 1,
        "ks": {
          "o": {"a": 0, "k": 100},
          "r": {"a": 0, "k": 0},
          "p": {"a": 0, "k": [${calc(params.size/2)}, ${calc(params.size/2)}, 0]},
          "a": {"a": 0, "k": [0, 0, 0]},
          "s": {
            "a": 1,
            "k": [
              {"t": 0, "s": [${params.scaleMin}, ${params.scaleMin}, 100], "e": [${params.scaleMax}, ${params.scaleMax}, 100], "i": {"x": [0.4,0.4,0.4], "y": [0,0,0]}, "o": {"x": [0.2,0.2,0.2], "y": [1,1,1]}},
              {"t": ${calc(params.durationFrames/2)}, "s": [${params.scaleMax}, ${params.scaleMax}, 100], "e": [${params.scaleMin}, ${params.scaleMin}, 100], "i": {"x": [0.4,0.4,0.4], "y": [0,0,0]}, "o": {"x": [0.2,0.2,0.2], "y": [1,1,1]}},
              {"t": ${params.durationFrames}}
            ]
          }
        },
        "ao": 0,
        "shapes": [
          {
            "ty": "el",
            "p": {"a": 0, "k": [0, 0]},
            "s": {"a": 0, "k": [${calc(params.size*0.4)}, ${calc(params.size*0.4)}]},
            "nm": "Ellipse Path"
          },
          {
            "ty": "fl",
            "c": {"a": 0, "k": ${color(${params.colorPrimary})}},
            "o": {"a": 0, "k": 100},
            "nm": "Fill"
          },
          {
            "ty": "st",
            "c": {"a": 0, "k": [0,0,0,1]},
            "o": {"a": 0, "k": 100},
            "w": {"a": 0, "k": ${params.stroke}},
            "lc": 2,
            "lj": 2,
            "nm": "Stroke"
          }
        ],
        "ip": 0,
        "op": ${params.durationFrames},
        "st": 0,
        "bm": 0
      }
    ]
  }
}
